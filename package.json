{
  "name": "alvaress",
  "version": "0.1.0",
  "description": "Arnés híbrido SDD/ODD con Laya local (ONNX), Vite-Plus, Aider opcional, OpenSpec, Obsidian y Graphify para OpenCode y Claude",
  "author": "alvaress contributors",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "alvaress": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "oxlint --deny=correctness --deny=suspicious src test",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "pretest": "pnpm run build",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:test",
    "commitlint": "commitlint",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run validate && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,mjs,cjs}": "oxlint --deny=correctness --deny=suspicious",
    "test/**/*.{ts,tsx,js,mjs,cjs}": "oxlint --deny=correctness --deny=suspicious"
  },
  "keywords": [
    "alvaress",
    "harness",
    "openspec",
    "obsidian",
    "graphify",
    "aider",
    "laya",
    "vite-plus",
    "opencode",
    "claude",
    "sdd",
    "odd",
    "agents",
    "pnpm",
    "onnx",
    "onnxruntime",
    "decision-engine"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
